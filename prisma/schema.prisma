// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Plan {
  id            Int            @id @default(autoincrement())
  name          String
  description   String
  price         Decimal        @db.Decimal(10, 2)
  annualPrice   Decimal        @db.Decimal(10, 2)
  maxJobs       Int
  maxAiResume   Int
  maxAiSalary   Int
  maxInterviews Int
  recommended   Boolean        @default(false)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

enum WorkFormat {
  REMOTE
  HYBRID
  ONSITE
}

enum JobStatus {
  ACTIVE
  INACTIVE
  HIRED
}

enum ContractType {
  CLT
  PJ
  FREELANCER
}

enum JobType {
  STANDARD
  INTERNSHIP
  TRAINEE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AffirmativeType {
  NOT_INFORMED
  PCD
  WOMEN
  FIFTY_PLUS
  LGBTQIAPN
}

model Benefit {
  id   Int          @id @default(autoincrement())
  name String       @unique
  jobs JobBenefit[]
}

model JobBenefit {
  jobId     Int
  benefitId Int

  job     Job     @relation(fields: [jobId], references: [id])
  benefit Benefit @relation(fields: [benefitId], references: [id])

  @@id([jobId, benefitId])
}

model Job {
  id Int @id @default(autoincrement())

  title       String
  description String @db.Text
  sectorId    Int
  positionId  Int

  status       JobStatus    @default(ACTIVE)
  contractType ContractType
  jobType      JobType      @default(STANDARD)
  workFormat   WorkFormat
  workload     Int

  salary Decimal? @db.Decimal(10, 2)

  priority    Priority        @default(MEDIUM)
  visible     Boolean         @default(true)
  affirmative AffirmativeType @default(NOT_INFORMED)
  deadline    DateTime?

  cep        String?
  state      String?
  city       String?
  district   String?
  address    String?
  number     String?
  complement String?

  companyId Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  benefits       JobBenefit[]
  customBenefits String[]

  applications Application[]
  profile      JobProfile?
}

model JobProfile {
  id       Int         @id @default(autoincrement())
  jobId    Int         @unique
  priority ProfileType

  analyst      Int @default(0)
  communicator Int @default(0)
  executor     Int @default(0)
  planner      Int @default(0)

  job Job @relation(fields: [jobId], references: [id])
}

enum ProfileType {
  ANALYST
  COMMUNICATOR
  EXECUTOR
  PLANNER
}

model Sector {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  positions Position[]
}

model Position {
  id       Int    @id @default(autoincrement())
  name     String @unique
  sectorId Int
  sector   Sector @relation(fields: [sectorId], references: [id])
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  employees  Int
  email      String
  phone      String
  site       String?
  cep        String
  address    String
  district   String
  number     String
  complement String?
  city       String
  state      String
  about      String
  cnpj       String  @unique

  asaasCustomerId String?
  cardToken       CardToken?

  onboardingCompleted Boolean        @default(false)
  subscription        Subscription[]
  users               User[]
  usageRecords        UsageRecord[]
  jobs                Job[]
  payments            Payment[]
}

model Subscription {
  id                  Int       @id @default(autoincrement())
  companyId           Int       @unique
  planId              Int
  isAnnual            Boolean   @default(false)
  startDate           DateTime  @default(now())
  endDate             DateTime?
  active              Boolean   @default(true)
  asaasSubscriptionId String
  canceledAt          DateTime?

  company  Company   @relation(fields: [companyId], references: [id])
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  companyId Int?
  createdAt DateTime @default(now())

  isVerified              Boolean   @default(false)
  verificationCode        String? // hash do código OTP
  verificationCodeExpires DateTime?
  verificationAttempts    Int       @default(0) // evita brute-force
  lastCodeSentAt          DateTime? // throttle de reenvio

  company Company? @relation(fields: [companyId], references: [id])
}

model CardToken {
  id        Int      @id @default(autoincrement())
  token     String // creditCardToken do Asaas
  lastFour  String // últimos 4 dígitos (ex: "1111")
  brand     String // VISA, MASTERCARD, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int     @unique
}

model WebhookLog {
  id                  Int      @id @default(autoincrement())
  event               String
  asaasPaymentId      String
  asaasSubscriptionId String
  payload             Json
  createdAt           DateTime @default(now())
}

model Payment {
  id                  Int           @id @default(autoincrement())
  asaasPaymentId      String        @unique
  asaasSubscriptionId String
  companyId           Int
  subscriptionId      Int?
  value               Decimal       @db.Decimal(10, 2)
  status              String
  billingType         String?
  dueDate             DateTime
  paidAt              DateTime?
  createdAt           DateTime      @default(now())
  company             Company       @relation(fields: [companyId], references: [id])
  subscription        Subscription? @relation(fields: [subscriptionId], references: [id])
}

model UsageRecord {
  id             Int @id @default(autoincrement())
  companyId      Int
  year           Int
  month          Int
  jobsUsed       Int @default(0)
  aiResumeUsed   Int @default(0)
  aiSalaryUsed   Int @default(0)
  interviewsUsed Int @default(0)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, year, month])
}

model Candidate {
  id                   Int       @id @default(autoincrement())
  name                 String
  email                String    @unique
  password             String
  phone                String?
  birthDate            DateTime?
  cpf                  String?   @unique
  profileTypeSecondary String?

  isVerified              Boolean   @default(false)
  verificationCode        String?
  verificationCodeExpires DateTime?
  verificationAttempts    Int       @default(0)
  lastCodeSentAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileType      String?
  profileCompleted Boolean @default(false)

  avatarUrl   String?
  avatarIndex Int?

  interests  CandidateInterest[]
  priorities CandidatePriority[]

  resume       CandidateResume?
  applications Application[]
}

model CandidateResume {
  id          Int     @id @default(autoincrement())
  candidateId Int     @unique
  cvFileUrl   String? // PDF uploadado
  isGuided    Boolean @default(false)
  isComplete  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate   Candidate          @relation(fields: [candidateId], references: [id])
  experiences ResumeExperience[]
  educations  ResumeEducation[]
  skills      ResumeSkill[]
  languages   ResumeLanguage[]
  extras      ResumeExtra[]
}

model ResumeExperience {
  id          Int       @id @default(autoincrement())
  resumeId    Int
  company     String?
  position    String?
  salary      String?
  description String?   @db.Text
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean   @default(false)

  resume CandidateResume @relation(fields: [resumeId], references: [id])
}

model ResumeEducation {
  id          Int            @id @default(autoincrement())
  resumeId    Int
  institution String
  course      String
  level       EducationLevel
  startDate   DateTime
  endDate     DateTime?
  current     Boolean        @default(false)

  resume CandidateResume @relation(fields: [resumeId], references: [id])
}

model ResumeSkill {
  id       Int         @id @default(autoincrement())
  resumeId Int
  name     String
  level    SkillLevel?

  resume CandidateResume @relation(fields: [resumeId], references: [id])
}

model ResumeLanguage {
  id       Int           @id @default(autoincrement())
  resumeId Int
  language String
  level    LanguageLevel

  resume CandidateResume @relation(fields: [resumeId], references: [id])
}

model ResumeExtra {
  id          Int       @id @default(autoincrement())
  resumeId    Int
  type        ExtraType
  title       String
  description String?
  url         String?
  date        DateTime?

  resume CandidateResume @relation(fields: [resumeId], references: [id])
}

model Application {
  id          Int               @id @default(autoincrement())
  candidateId Int
  jobId       Int
  status      ApplicationStatus @default(RECEBIDA)
  cvSnapshot  String?
  notes       String?           @db.Text

  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate       Candidate            @relation(fields: [candidateId], references: [id])
  job             Job                  @relation(fields: [jobId], references: [id])
  history         ApplicationHistory[]
  interviewEvents InterviewEvent[]

  @@unique([candidateId, jobId])
}

model ApplicationHistory {
  id            Int               @id @default(autoincrement())
  applicationId Int
  status        ApplicationStatus
  note          String?
  changedAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id])
}

enum InterviewEventType {
  INVITE_SENT
  CONFIRMED
  DECLINED
  RESCHEDULED
}

model InterviewEvent {
  id            Int                @id @default(autoincrement())
  applicationId Int
  type          InterviewEventType
  message       String?
  note          String?
  meetingLink   String?
  address       String?
  scheduledAt   DateTime?
  interviewType String?
  proposedAt    DateTime?
  createdAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id])
}

enum ApplicationStatus {
  RECEBIDA
  ANALISE
  ENTREVISTA
  APROVADO
  REPROVADO
  DESISTIU
}

enum EducationLevel {
  NAO_ALFABETIZADO
  NAO_ESCOLARIZADO
  FUNDAMENTAL
  MEDIO
  TECNICO
  SUPERIOR
  POS_GRADUACAO
  MESTRADO
  DOUTORADO
}

enum SkillLevel {
  BASICO
  INTERMEDIARIO
  AVANCADO
  ESPECIALISTA
}

enum LanguageLevel {
  BASICO
  INTERMEDIARIO
  AVANCADO
  FLUENTE
  NATIVO
}

enum ExtraType {
  CERTIFICADO
  CURSO
  PORTFOLIO
  PREMIO
  PUBLICACAO
  OUTRO
}

model Interest {
  id       Int    @id @default(autoincrement())
  name     String @unique
  emoji    String
  category String

  candidates CandidateInterest[]
}

model CandidateInterest {
  candidateId Int
  interestId  Int

  candidate Candidate @relation(fields: [candidateId], references: [id])
  interest  Interest  @relation(fields: [interestId], references: [id])

  @@id([candidateId, interestId])
}

model ProfessionalPriority {
  id   Int    @id @default(autoincrement())
  name String @unique
  icon String

  candidates CandidatePriority[]
}

model CandidatePriority {
  candidateId Int
  priorityId  Int
  order       Int

  candidate Candidate            @relation(fields: [candidateId], references: [id])
  priority  ProfessionalPriority @relation(fields: [priorityId], references: [id])

  @@id([candidateId, priorityId])
}
